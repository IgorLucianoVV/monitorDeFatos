# ===================== Chaves (preencha as que tiver) =====================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Busca alternativa com trechos de conteúdo (https://tavily.com)
TAVILY_API_KEY=
# Transcrição em tempo real com separação de oradores (https://deepgram.com)
DEEPGRAM_API_KEY=

# ===================== Servidor =====================
PORT=3000
# Se definido, a interface pede o token e /api/* e /ws/* exigem-no
ACCESS_TOKEN=

# ===================== LLMs (LangGraph) =====================
# Formato provedor:modelo, separados por vírgula. O 1º é o primário, os demais são fallback.
# Provedores: anthropic | openai | google. Entradas sem chave configurada são ignoradas.
LLM_FAST=anthropic:claude-haiku-5-5,openai:gpt-5.5
LLM_JUDGE=anthropic:claude-sonnet-5-5,openai:gpt-5.5
# Exemplo com Gemini como fallback: LLM_JUDGE=anthropic:claude-sonnet-5-5,google:<modelo-gemini>

# ===================== Busca =====================
# Ordem de preferência: anthropic | openai | tavily
SEARCH_PROVIDERS=anthropic,openai,tavily
# fallback = usa o 1º que trouxer evidência | merge = consulta todos e junta (mais cobertura, mais custo)
SEARCH_MODE=fallback
SEARCH_ANTHROPIC_MODEL=claude-haiku-5-5
SEARCH_ANTHROPIC_TOOL=web_search_20250305
SEARCH_OPENAI_MODEL=gpt-5.5
# Esforço de raciocínio do modelo OpenAI na busca; deixe vazio para modelos sem reasoning (ex.: gpt-4.1)
SEARCH_OPENAI_REASONING=low
MAX_QUERIES_PER_ROUND=3
MAX_SEARCH_ROUNDS=2
MAX_EVIDENCE=12
# Lista própria de domínios confiáveis (vírgula). Vazio = lista padrão em src/config.js
TRUSTED_DOMAINS=

# ===================== Transcrição =====================
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt-BR
# Parâmetro de diarização do Deepgram (atual: diarize_model=latest; legado: diarize=true)
DEEPGRAM_DIARIZE_PARAM=diarize_model=latest
# Diarização em trechos (OpenAI)
DIARIZE_MODEL=gpt-4o-transcribe-diarize
# Transcrição sem oradores
TRANSCRIBE_MODEL=whisper-1

CACHE_TTL_MIN=360
